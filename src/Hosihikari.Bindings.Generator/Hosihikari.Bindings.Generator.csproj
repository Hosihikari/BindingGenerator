<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari.Bindings.Generator</RootNamespace>
    <AssemblyName>Hosihikari.Bindings.Generator</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.3.0</Version>
    <Authors>Hosihikari</Authors>
    <Description>Generates C ABI BindingShim and native-style .NET Interop from versioned IR.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Hosihikari/BindingGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;binding;interop;hosihikari</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../BindingIr/src/Hosihikari.Bindings.Ir/Hosihikari.Bindings.Ir.csproj" />
  </ItemGroup>

</Project>
