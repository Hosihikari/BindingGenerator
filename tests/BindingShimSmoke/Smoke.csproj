<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InteropDirectory Condition="'$(InteropDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\llapi-real-shim\interop</InteropDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(InteropDirectory)/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Bindings.Abi/src/Hosihikari.Bindings.Abi/Hosihikari.Bindings.Abi.csproj" />
  </ItemGroup>
</Project>
